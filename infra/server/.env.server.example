# Public hostnames. sslip.io resolves these names to 62.113.105.225.
CRM_DOMAIN=crm.62-113-105-225.sslip.io
ID_DOMAIN=id.62-113-105-225.sslip.io
S3_DOMAIN=files.62-113-105-225.sslip.io
ACME_EMAIL=CHANGE_ME@example.com
IMAGE_TAG=latest

# Main PostgreSQL database. Generate URL-safe secrets, for example:
# openssl rand -hex 32
POSTGRES_DB=cpi_crm
POSTGRES_USER=cpi_crm
POSTGRES_PASSWORD=CHANGE_ME_64_HEX

# Non-owner login used by API, worker, seed and importer.
APP_DB_USER=cpi_app
APP_DB_PASSWORD=CHANGE_ME_64_HEX

# Keycloak uses an isolated database and login.
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CHANGE_ME_64_HEX
KEYCLOAK_ADMIN_USERNAME=crm-superadmin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# First CRM user, created only during the initial realm import. Keycloak asks
# this user to change the temporary password after the first login.
CRM_ADMIN_USERNAME=crm-admin
CRM_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
CRM_ADMIN_EMAIL=CHANGE_ME@example.com

# The same confidential-client secret is injected into Keycloak and the API.
OIDC_CLIENT_ID=cpi-crm
OIDC_CLIENT_SECRET=CHANGE_ME_64_HEX
# Must decode to exactly 32 bytes: openssl rand -base64 32
SESSION_KEY_BASE64=CHANGE_ME_BASE64_32_BYTES

# Server-to-server integration with Locker. Generate once with openssl rand -hex 32
# and place the same value in /opt/CPI-TG-BOT/infra/server/.env.
LOCKER_BASE_URL=https://artifacts.62-113-105-225.sslip.io
LOCKER_INTEGRATION_TOKEN=CHANGE_ME_64_HEX

# Campaigns. Leave TELEGRAM_BOT_TOKEN or UNISENDER_API_KEY empty to keep that channel off.
TELEGRAM_BOT_TOKEN=
CAMPAIGN_BOT_LINK=https://t.me/cpi_artifacts_bot
# Unisender Go. The key is created per project in the provider dashboard, and the
# same secret goes into the webhook URL registered there: openssl rand -hex 32
UNISENDER_API_KEY=
UNISENDER_API_URL=https://goapi.unisender.ru/ru/transactional/api/v1
CAMPAIGN_WEBHOOK_SECRET=CHANGE_ME_64_HEX
# Safety cap on our side, not a provider limit.
CAMPAIGN_EMAIL_DAILY_LIMIT=3000
CAMPAIGN_FROM_EMAIL=
# Кавычки обязательны: deploy.sh и backup.sh подгружают файл через source.
CAMPAIGN_FROM_NAME="Стартап-студия ЦПИ"
CAMPAIGN_REPLY_TO=

# Облачное S3-хранилище артефактов, общее с ботом сбора артефактов.
# В бакете два дерева: crm/ и locker/ — их разделяет S3_PREFIX.
# Браузер ходит за файлами через https://<CRM_DOMAIN>/storage, поэтому имя хоста
# хранилища нужно Caddy отдельно: он проксирует туда запросы, подставляя Host.
S3_ENDPOINT=https://s3.ru1.storage.beget.cloud
S3_UPSTREAM=s3.ru1.storage.beget.cloud
S3_REGION=ru1
S3_BUCKET=CHANGE_ME_BUCKET_NAME
S3_PREFIX=crm/
S3_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_SECRET_KEY

ORGANIZATION_TIMEZONE=Asia/Novosibirsk
ARTIFACT_BASELINE_AT=2026-07-22T00:00:00.000Z
LOG_LEVEL=info
WORKER_OUTBOX_BATCH_SIZE=5
WORKER_RECONCILIATION_BATCH_SIZE=100
ARTIFACT_ARCHIVE_AFTER_WEEKS=12

# Path is resolved relative to infra/server/docker-compose.yml.
IMPORT_WORKBOOK_HOST=../../Участники_всех_мероприятий_Стартап_студии_ЯДРО1.xlsx
